# Example reconciler env file (never commit real tokens).
# Copy to /home/ec2-user/unchained/.env.reconciler and customize.
#
# The reconciler is a host-side singleton systemd service. It communicates
# with the gateway's private management API via docker exec and controls
# only the six allowlisted worker seat containers.

# Master enable. Defaults to false; set to true ONLY after all gates pass.
TERMINAL_RUNTIME_FEATURE_ENABLED=false

# Management token — must match the gateway's TERMINAL_RUNTIME_MANAGEMENT_TOKEN.
# Use `python3 -c "import secrets; print(secrets.token_hex(32))"` to generate.
TERMINAL_RUNTIME_MANAGEMENT_TOKEN=

# Private gateway management port (default 8789). Must match the gateway's
# TERMINAL_RUNTIME_MANAGEMENT_PORT. Never published, never proxied by Caddy.
TERMINAL_RUNTIME_MANAGEMENT_PORT=8789

# Docker Compose project name and working directory.
TERMINAL_RUNTIME_COMPOSE_PROJECT=unchained
TERMINAL_RUNTIME_COMPOSE_DIR=/home/ec2-user/unchained

# Reconcile loop interval in seconds (minimum 5).
TERMINAL_RUNTIME_RECONCILE_INTERVAL=15

# Idle scale-down threshold in seconds (minimum 30).
# Unassigned seats idle longer than this become scale-down candidates.
TERMINAL_RUNTIME_IDLE_SCALE_DOWN=300

# Maximum concurrent seat starts per reconcile cycle (minimum 1).
TERMINAL_RUNTIME_MAX_START_CONCUR=2

# Host resource guard thresholds.
TERMINAL_RUNTIME_HOST_MEM_RESERVE_MB=512
TERMINAL_RUNTIME_HOST_MEM_HEADROOM_PCT=15
TERMINAL_RUNTIME_HOST_DISK_MAX_PCT=85
