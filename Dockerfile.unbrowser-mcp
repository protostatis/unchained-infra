FROM python:3.13-slim

WORKDIR /app

RUN useradd -m -u 10001 -s /bin/bash unchained \
    && mkdir -p /app /data \
    && chown -R unchained:unchained /app /data

COPY unchained/unbrowser_ssrf_proxy.py .
COPY unchained/unbrowser_mcp_router.py .

RUN pip install --no-cache-dir \
    "mcp-proxy==0.12.0" \
    "mcp==1.29.0" \
    "pyunbrowser==0.0.21"

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HOME=/home/unchained
ENV HTTP_PROXY=http://unbrowser-egress:8888
ENV HTTPS_PROXY=http://unbrowser-egress:8888
ENV ALL_PROXY=http://unbrowser-egress:8888
ENV NO_PROXY=
ENV http_proxy=http://unbrowser-egress:8888
ENV https_proxy=http://unbrowser-egress:8888
ENV all_proxy=http://unbrowser-egress:8888
ENV no_proxy=

EXPOSE 8767

USER 10001:10001

CMD ["python3", "unbrowser_mcp_router.py", "--host", "0.0.0.0", "--port", "8767"]
