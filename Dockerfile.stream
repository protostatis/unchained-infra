# Dockerfile.stream — 24/7 autonomous streaming container
# Xvfb + Chromium + FFmpeg + PulseAudio → RTMP or file
#
# Build:  docker compose -f docker-compose.stream.yml build
# Run:    docker compose -f docker-compose.stream.yml up

FROM python:3.13-slim

# System deps: Chromium, virtual display, audio, streaming
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    xvfb \
    ffmpeg \
    pulseaudio \
    dbus \
    curl \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    fonts-liberation \
    x11vnc \
    novnc \
    websockify \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 10001 -s /bin/bash unchained \
    && mkdir -p /run/user/10001 /output \
    && chown -R unchained:unchained /run/user/10001 /output

# Python deps
RUN pip install --no-cache-dir \
    websockets \
    aiohttp \
    anthropic \
    edge-tts \
    httpx \
    yt-dlp

WORKDIR /app

# Copy application files
COPY unchained/agent_stream.py unchained/cdp.py unchained/stream_ctl.py unchained/pyproject.toml ./
COPY stream_entry.sh ./

RUN chmod +x stream_entry.sh

# Output directory for local file recording
RUN mkdir -p /output

# Expose only the overlay preview port publicly; CDP and noVNC stay internal.
EXPOSE 8878

ENTRYPOINT ["./stream_entry.sh"]
