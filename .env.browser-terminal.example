# Example environment for the authenticated browser-owned terminal canary.
# Never commit real tokens or API keys. Copy these values into the host .env
# only after the image has passed preflight; the route remains disabled until
# direct service commissioning is complete.

# Caddy route switch. Keep false during image and service commissioning.
FIN_TERMINAL_BROWSER_ENABLED=false

# Immutable arm64 release artifact published from unbrowser-fin-terminal.
FIN_TERMINAL_BROWSER_IMAGE=ghcr.io/protostatis/unbrowser-fin-terminal-browser@sha256:5ea7f46d4cf761ceb66f881ba209933dc4da1f4eb1569c9be0d44770d3c86df2

# Dedicated browser-canary edge-to-broker token. Generate a new 32+ byte value
# and keep it different from FIN_TERMINAL_PROXY_TOKEN.
FIN_TERMINAL_BROWSER_PROXY_TOKEN=

# Optional browser-canary model controls. OPENROUTER_API_KEY is read from the
# host's existing secret environment and is intentionally not duplicated here.
FIN_TERMINAL_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
FIN_TERMINAL_MAX_OUTPUT_TOKENS=4096
