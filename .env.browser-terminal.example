# Example environment for the primary authenticated browser-owned terminal.
# Never commit real tokens or API keys. Copy these values into the host .env
# only after the image has passed preflight; the route remains disabled until
# direct service commissioning is complete.

# Caddy route switch. Keep false during image and service commissioning.
FIN_TERMINAL_BROWSER_ENABLED=false

# Immutable arm64 release artifact published from unbrowser-fin-terminal. The
# image's OCI revision label must exactly match this source revision.
FIN_TERMINAL_BROWSER_SOURCE_REVISION=6a786a04640c68da8bc82260cba6c7fff80bc134
FIN_TERMINAL_BROWSER_IMAGE=ghcr.io/protostatis/unbrowser-fin-terminal-browser@sha256:1b5c54ab2afb06ee37d385c273736afc533be2a735070a2ab6d2786f370595b3

# Private global research cache runner (shadow event-scout polling, model
# dispatch off). Same source revision as the browser image above; shares the
# browser data volume at /data/global-cache. Keep disabled until the shared
# volume and MCP wiring are verified in preflight.
FIN_TERMINAL_GLOBAL_CACHE_ENABLED=false
FIN_TERMINAL_GLOBAL_CACHE_SOURCE_REVISION=6a786a04640c68da8bc82260cba6c7fff80bc134
FIN_TERMINAL_GLOBAL_CACHE_IMAGE=ghcr.io/protostatis/unbrowser-fin-terminal-global-cache@sha256:82ad1a2678a9b59ef5fc0c55a892116e9f301b87f3819dfb18e7fafd7b35fbb6

# Dedicated browser-canary edge-to-broker token. Generate a new 32+ byte value
# and do not reuse any other service credential.
FIN_TERMINAL_BROWSER_PROXY_TOKEN=

# Optional browser-canary model controls. OPENROUTER_API_KEY is read from the
# host's existing secret environment and is intentionally not duplicated here.
FIN_TERMINAL_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
FIN_TERMINAL_MAX_OUTPUT_TOKENS=4096
FIN_TERMINAL_WATCHLIST_IMPORT_MODEL=google/gemini-2.5-flash
FIN_TERMINAL_BROWSER_DAILY_RESEARCH_REQUESTS=40
FIN_TERMINAL_BROWSER_DAILY_IMPORTS=5
FIN_TERMINAL_BROWSER_PROVIDER_BUDGET_USD=25
FIN_TERMINAL_BROWSER_INPUT_USD_PER_MILLION_TOKENS=1
FIN_TERMINAL_BROWSER_OUTPUT_USD_PER_MILLION_TOKENS=4
FIN_TERMINAL_BROWSER_IMPORT_ESTIMATE_USD=0.05
