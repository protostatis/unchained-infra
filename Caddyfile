unchainedsky.com, www.unchainedsky.com, api.unchainedsky.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Per-request access log to stderr in JSON. Lands in
	# `docker compose logs caddy` (mixed with TLS/proxy errors).
	# Captures method, path, status, latency, remote_ip, headers
	# (User-Agent, Referer) — useful for funnel/origin analysis
	# when a new user signs up. Default rotation is handled by
	# Docker's json-file driver.
	log {
		output stderr
		format json
	}

	request_body {
		max_size 10MB
	}

	# WebSocket tunnel — agents connect here
	handle /tunnel {
		reverse_proxy relay:8765
	}

	# CDP WebSocket proxy — clients connect here
	handle /cdp/* {
		reverse_proxy relay:8765
	}

	# REST API — orchestrator uses these
	handle /api/* {
		reverse_proxy relay:8765
	}

	# unbrowser MCP server — separate from Unchained's FastMCP /mcp endpoint.
	# Streamable HTTP only; SSE's /messages callback cannot live safely under this prefix.
	handle /unbrowser-mcp {
		rewrite * /mcp
		reverse_proxy unbrowser-mcp:8767
	}
	handle /unbrowser-mcp/sse {
		respond "Use Streamable HTTP at /unbrowser-mcp or /unbrowser-mcp/mcp." 404
	}
	handle_path /unbrowser-mcp/* {
		reverse_proxy unbrowser-mcp:8767
	}

	# The authenticated terminal and the now-retired replay demo were separate
	# applications at the dedicated Unbrowser host. Replay is retired so its
	# legacy URLs return direct HTTP 404 (no redirect). The authenticated
	# terminal redirect remains active.
	@legacy_fin_terminal_demo path /unbrowser/fin-terminal-demo /unbrowser/fin-terminal-demo/*
	handle @legacy_fin_terminal_demo {
		header Cache-Control "no-store"
		respond "Not found" 404
	}
	@legacy_fin_terminal_demo_alias path /unbrowser/fin-terminal/demo /unbrowser/fin-terminal/demo/*
	handle @legacy_fin_terminal_demo_alias {
		header Cache-Control "no-store"
		respond "Not found" 404
	}
	@legacy_fin_terminal {
		path_regexp legacy_fin_terminal ^/unbrowser/fin-terminal(?:/(.*))?$
		not path /unbrowser/fin-terminal/demo /unbrowser/fin-terminal/demo/*
	}
	redir @legacy_fin_terminal https://unbrowser.unchainedsky.com/fin-terminal/{re.legacy_fin_terminal.1}{?query} 308
	@legacy_unbrowser_page path /unbrowser /unbrowser/
	redir @legacy_unbrowser_page https://unbrowser.unchainedsky.com/{?query} 308

	# MCP SSE stream — GET /mcp with Accept: text/event-stream → MCP server
	@mcp_sse {
		method GET
		path /mcp
		header Accept *text/event-stream*
	}
	handle @mcp_sse {
		reverse_proxy mcp:8766
	}

	# MCP install page — GET /mcp from browsers → web UI setup page
	@mcp_page {
		method GET
		path /mcp
	}
	handle @mcp_page {
		reverse_proxy web:8080 {
			# Hold requests briefly while the single web container is being
			# recreated. Caddy only retries non-idempotent requests after a
			# failed connection, so a request already accepted by web is not
			# replayed.
			lb_try_duration 5s
		}
	}

	# MCP server — POST /mcp and /mcp/* route to MCP transport
	handle /mcp {
		reverse_proxy mcp:8766
	}
	handle /mcp/* {
		reverse_proxy mcp:8766
	}

	# Private core — agent packages call /core/execute (bearer-token auth)
	handle /core/* {
		reverse_proxy private-core:8770
	}

	# Health check
	handle /health {
		reverse_proxy relay:8765
	}

	# Hosted-worker callbacks are available only on the Docker-internal web
	# listener. Never proxy this namespace from the public edge.
	handle /internal/* {
		respond "Not found" 404
	}

	# Web UI API
	handle /web/* {
		reverse_proxy web:8080 {
			lb_try_duration 5s
		}
	}

	# Web UI — catch-all serves mobile control panel
	handle {
		reverse_proxy web:8080 {
			lb_try_duration 5s
		}
	}
}

# Dedicated public Unbrowser site. Keep this separate from the primary site so
# the subdomain exposes only its landing page, supporting endpoints,
# authenticated terminal, retired-demo tombstones, and opt-in live pilot—not
# the API, tunnel, or primary MCP routes.
unbrowser.unchainedsky.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stderr
		format json
	}

	request_body {
		max_size 10MB
	}

	# Keep primary-product destinations on their existing canonical host.
	@primary_site_paths path /mcp /mcp/* /first-look /chrome-tax /install /install/*
	redir @primary_site_paths https://unchainedsky.com{uri} 308
	@unbrowser_subpath path /unbrowser /unbrowser/
	redir @unbrowser_subpath https://unbrowser.unchainedsky.com/{?query} 308
	# Authenticated persistent terminal. The path prefix is stripped upstream so
	# the Vite-built client and its WebSocket both resolve beneath /fin-terminal/.
	@fin_terminal_base path /fin-terminal
	redir @fin_terminal_base https://unbrowser.unchainedsky.com/fin-terminal/{?query} 308
	handle_path /fin-terminal/* {
		route {
			# Never trust identity or service-auth headers supplied by a client.
			request_header -X-Fin-Terminal-User
			request_header -X-Fin-Terminal-Proxy-Token
			forward_auth web:8080 {
				uri /internal/fin-terminal/auth
				copy_headers X-Fin-Terminal-User
			}
			# Browser credentials are only for forward_auth. The terminal trusts the
			# opaque principal above and must never receive a session or API token.
			request_header -Cookie
			request_header -Authorization
			request_header -Proxy-Authorization
			reverse_proxy fin-terminal:8787 {
				header_up X-Fin-Terminal-Proxy-Token {$FIN_TERMINAL_PROXY_TOKEN}
			}
		}
	}

	# The static fin-terminal replay demo is retired. All requests to its
	# former URLs return a direct HTTP 404 (no redirect, no-store).
	# The live-session pilot below is the only public terminal path.
	@fin_terminal_demo_retired path /fin-terminal-demo /fin-terminal-demo/*
	handle @fin_terminal_demo_retired {
		header Cache-Control "no-store"
		respond "Not found" 404
	}

	# Opt-in live-session pilot. The gateway verifies Turnstile, owns the FIFO
	# queue, and proxies a guest only to an isolated internal worker. Its path is
	# intentionally separate from the retired replay URLs.
	@fin_terminal_live_pilot_base {
		path /fin-terminal-live-pilot
		expression `{$FIN_TERMINAL_PUBLIC_ENABLED:false}`
	}
	redir @fin_terminal_live_pilot_base https://unbrowser.unchainedsky.com/fin-terminal-live-pilot/{?query} 308
	@fin_terminal_live_pilot {
		path /fin-terminal-live-pilot/*
		expression `{$FIN_TERMINAL_PUBLIC_ENABLED:false}`
	}
	handle @fin_terminal_live_pilot {
		uri strip_prefix /fin-terminal-live-pilot
		# Ticket capabilities travel in request headers / WebSocket protocols.
		# Do not retain them in edge access logs.
		log_skip
		header {
			Content-Security-Policy "default-src 'self'; connect-src 'self' wss://unbrowser.unchainedsky.com https://challenges.cloudflare.com; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
		}
		route {
			# The gateway accepts only signed opaque public-session tokens. Strip
			# caller-supplied terminal identity/service headers before proxying.
			request_header -X-Fin-Terminal-User
			request_header -X-Fin-Terminal-Proxy-Token
			request_header -X-Fin-Terminal-Edge-Token
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -X-Real-IP
			# Public admission uses signed opaque headers / WebSocket protocol, not
			# browser cookies. Do not pass a signed-in visitor's cookie to it.
			request_header -Cookie
			reverse_proxy fin-terminal-public-gateway:8788 {
				header_up X-Real-IP {remote_host}
				header_up X-Fin-Terminal-Edge-Token {$FIN_TERMINAL_PUBLIC_EDGE_PROXY_TOKEN}
			}
		}
	}

	# The root reuses the existing public landing-page handler. Only its fixed
	# supporting endpoints are exposed on this host.
	@unbrowser_outbound path /go/unbrowser-connect /go/unbrowser-github /go/unbrowser-smithery
	handle @unbrowser_outbound {
		reverse_proxy web:8080
	}
	handle /web/unbrowser/* {
		reverse_proxy web:8080
	}
	handle /web/analytics/* {
		reverse_proxy web:8080
	}
	handle /favicon.svg {
		reverse_proxy web:8080
	}
	handle / {
		rewrite * /unbrowser
		reverse_proxy web:8080
	}
	handle {
		respond "Not found" 404
	}
}
