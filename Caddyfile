unchainedsky.com, www.unchainedsky.com, api.unchainedsky.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Per-request access log to stderr in JSON. Lands in
	# `docker compose logs caddy` (mixed with TLS/proxy errors).
	# Captures method, path, status, latency, remote_ip, headers
	# (User-Agent, Referer) — useful for funnel/origin analysis
	# when a new user signs up. Default rotation is handled by
	# Docker's json-file driver.
	log {
		output stderr
		format json
	}

	request_body {
		max_size 10MB
	}

	# WebSocket tunnel — agents connect here
	handle /tunnel {
		reverse_proxy relay:8765
	}

	# CDP WebSocket proxy — clients connect here
	handle /cdp/* {
		reverse_proxy relay:8765
	}

	# REST API — orchestrator uses these
	handle /api/* {
		reverse_proxy relay:8765
	}

	# unbrowser MCP server — separate from Unchained's FastMCP /mcp endpoint.
	# Streamable HTTP only; SSE's /messages callback cannot live safely under this prefix.
	handle /unbrowser-mcp {
		rewrite * /mcp
		reverse_proxy unbrowser-mcp:8767
	}
	handle /unbrowser-mcp/sse {
		respond "Use Streamable HTTP at /unbrowser-mcp or /unbrowser-mcp/mcp." 404
	}
	handle_path /unbrowser-mcp/* {
		reverse_proxy unbrowser-mcp:8767
	}

	# The public terminal demo is canonical at the dedicated Unbrowser host.
	# Preserve full paths and query strings for old shared links, including the
	# earlier nested alias.
	@legacy_fin_terminal_demo path_regexp legacy_fin_terminal_demo ^/unbrowser/fin-terminal-demo/?(.*)$
	redir @legacy_fin_terminal_demo https://unbrowser.unchainedsky.com/fin-terminal/demo/{re.legacy_fin_terminal_demo.1}{?query} 308
	@legacy_fin_terminal_demo_alias path_regexp legacy_fin_terminal_demo_alias ^/unbrowser/fin-terminal/demo/?(.*)$
	redir @legacy_fin_terminal_demo_alias https://unbrowser.unchainedsky.com/fin-terminal/demo/{re.legacy_fin_terminal_demo_alias.1}{?query} 308
	@legacy_unbrowser_page path /unbrowser /unbrowser/
	redir @legacy_unbrowser_page https://unbrowser.unchainedsky.com/{?query} 308

	# Authenticated singleton financial terminal. The exact path redirects to
	# the build-time base path; handle_path strips that prefix upstream.
	handle /unbrowser/fin-terminal {
		redir /unbrowser/fin-terminal/ 308
	}
	handle_path /unbrowser/fin-terminal/* {
		route {
			# Never trust identity or service-auth headers supplied by a client.
			request_header -X-Fin-Terminal-User
			request_header -X-Fin-Terminal-Proxy-Token
			forward_auth web:8080 {
				uri /internal/fin-terminal/auth
				copy_headers X-Fin-Terminal-User
			}
			reverse_proxy fin-terminal:8787 {
				header_up X-Fin-Terminal-Proxy-Token {$FIN_TERMINAL_PROXY_TOKEN}
			}
		}
	}

	# MCP SSE stream — GET /mcp with Accept: text/event-stream → MCP server
	@mcp_sse {
		method GET
		path /mcp
		header Accept *text/event-stream*
	}
	handle @mcp_sse {
		reverse_proxy mcp:8766
	}

	# MCP install page — GET /mcp from browsers → web UI setup page
	@mcp_page {
		method GET
		path /mcp
	}
	handle @mcp_page {
		reverse_proxy web:8080 {
			# Hold requests briefly while the single web container is being
			# recreated. Caddy only retries non-idempotent requests after a
			# failed connection, so a request already accepted by web is not
			# replayed.
			lb_try_duration 5s
		}
	}

	# MCP server — POST /mcp and /mcp/* route to MCP transport
	handle /mcp {
		reverse_proxy mcp:8766
	}
	handle /mcp/* {
		reverse_proxy mcp:8766
	}

	# Private core — agent packages call /core/execute (bearer-token auth)
	handle /core/* {
		reverse_proxy private-core:8770
	}

	# Health check
	handle /health {
		reverse_proxy relay:8765
	}

	# Hosted-worker callbacks are available only on the Docker-internal web
	# listener. Never proxy this namespace from the public edge.
	handle /internal/* {
		respond "Not found" 404
	}

	# Web UI API
	handle /web/* {
		reverse_proxy web:8080 {
			lb_try_duration 5s
		}
	}

	# Web UI — catch-all serves mobile control panel
	handle {
		reverse_proxy web:8080 {
			lb_try_duration 5s
		}
	}
}

# Dedicated public Unbrowser site. Keep this separate from the primary site so
# the subdomain exposes only its landing page, supporting endpoints, and the
# public terminal demo—not the API, tunnel, or MCP routes.
unbrowser.unchainedsky.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output stderr
		format json
	}

	request_body {
		max_size 10MB
	}

	# Keep primary-product destinations on their existing canonical host.
	@primary_site_paths path /mcp /mcp/* /first-look /chrome-tax /install /install/*
	redir @primary_site_paths https://unchainedsky.com{uri} 308
	@unbrowser_subpath path /unbrowser /unbrowser/
	redir @unbrowser_subpath https://unbrowser.unchainedsky.com/{?query} 308
	@terminal_demo_base path /fin-terminal /fin-terminal/
	redir @terminal_demo_base https://unbrowser.unchainedsky.com/fin-terminal/demo/{?query} 308

	# The terminal is an explicit sub-path of the Unbrowser product site.
	handle /fin-terminal/demo {
		redir /fin-terminal/demo/ 308
	}
	handle_path /fin-terminal/demo/* {
		route {
			# Never trust identity, service-auth, or client-IP headers supplied
			# by a client; inject the real visitor IP for app rate limiting.
			request_header -X-Fin-Terminal-User
			request_header -X-Fin-Terminal-Proxy-Token
			request_header -X-Real-IP
			reverse_proxy fin-terminal-demo:8788 {
				header_up X-Fin-Terminal-User guest
				header_up X-Fin-Terminal-Proxy-Token {$FIN_TERMINAL_PROXY_TOKEN}
				header_up X-Real-IP {http.request.remote.host}
			}
		}
	}

	# The root reuses the existing public landing-page handler. Only its fixed
	# supporting endpoints are exposed on this host.
	@unbrowser_outbound path /go/unbrowser-connect /go/unbrowser-github /go/unbrowser-smithery
	handle @unbrowser_outbound {
		reverse_proxy web:8080
	}
	handle /web/unbrowser/* {
		reverse_proxy web:8080
	}
	handle /web/analytics/* {
		reverse_proxy web:8080
	}
	handle /favicon.svg {
		reverse_proxy web:8080
	}
	handle / {
		rewrite * /unbrowser
		reverse_proxy web:8080
	}
	handle {
		respond "Not found" 404
	}
}
