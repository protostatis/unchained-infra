# Dedicated headless worker settings (separate EC2 instance)

# Auth key used by BOTH headless-bridge and headless-agent.
UNCHAINED_API_KEY=uc_live_replace_me

# Must match TRIAL_AGENT_ID configured on the main web server.
TRIAL_AGENT_ID=a-trial0000

# OpenRouter credentials/model.
OPENROUTER_API_KEY=sk-or-replace_me
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free

# Main Unchained server and relay endpoints (usually your existing production host).
UNCHAINED_SERVER=wss://api.unchainedsky.com
UNCHAINED_RELAY_URL=wss://api.unchainedsky.com/tunnel
RELAY_HOST=api.unchainedsky.com
RELAY_PORT=443

# Optional Chrome tuning.
CDP_PROFILE=ec2-headless
CDP_PORT=9222
UNCHAINED_CHROME_ARGS=--disable-background-networking --disable-extensions --disable-features=Translate,MediaRouter

# ============================================
# WireGuard VPN (optional — masks headless Chrome IP)
# ============================================
# Run deploy/setup-wireguard.sh on the EC2 host to configure.
# Uses Mullvad WireGuard. Same account as PanicRadar crawler.
#
WG_PRIVATE_KEY=
WG_ADDRESS=10.x.x.x/32
WG_DNS=10.64.0.1
WG_PEER_PUBKEY=
WG_ENDPOINT=server_ip:51820
