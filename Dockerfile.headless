FROM python:3.13-slim

WORKDIR /app

# Headless Chromium + CA roots/fonts for modern websites.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ca-certificates \
    fonts-liberation \
    unzip curl \
    && rm -rf /var/lib/apt/lists/*

# NopeCHA — auto-solves CAPTCHAs (reCAPTCHA, hCaptcha, Turnstile, PerimeterX)
# transparently via Chrome extension. Free tier: 100 solves/day, no API key.
# Manifest V3 permissions: debugger, declarativeNetRequest, storage, scripting,
# host_permissions <all_urls>. No webRequestBlocking.
# Disable by setting NOPECHA_EXT_DIR= (empty) in .env.headless.
#
# SHA256 verification: hash obtained by downloading the release asset directly
# from GitHub and running `sha256sum chromium_automation.zip`. To upgrade:
#   curl -fsSL https://github.com/NopeCHALLC/nopecha-extension/releases/download/<VER>/chromium_automation.zip -o nopecha.zip
#   sha256sum nopecha.zip
# Then update both NOPECHA_VERSION and NOPECHA_SHA256 below.
ARG NOPECHA_VERSION=0.5.5
ARG NOPECHA_SHA256=ed22fc4d75562efeca996ac4611cf0d9283ffa9dbcd6cfce59a2c5ee58d784d8
RUN mkdir -p /opt/nopecha /usr/share/chromium/extensions \
    && curl -fsSL "https://github.com/NopeCHALLC/nopecha-extension/releases/download/${NOPECHA_VERSION}/chromium_automation.zip" \
       -o /tmp/nopecha.zip \
    && echo "${NOPECHA_SHA256}  /tmp/nopecha.zip" | sha256sum -c - \
    && unzip -q /tmp/nopecha.zip -d /opt/nopecha \
    && rm /tmp/nopecha.zip \
    && chown -R 10001:10001 /opt/nopecha \
    && ln -s /opt/nopecha /usr/share/chromium/extensions/nopecha

RUN useradd -m -u 10001 -s /bin/bash unchained \
    && mkdir -p /app /data \
    && chown -R unchained:unchained /app /data

# Copy only modules required by chrome_bridge + OpenRouter trial agent.
COPY unchained/auth.py .
COPY unchained/chat_agent_openrouter.py .
COPY unchained/chat_event_transport.py .
COPY unchained/conversation_transcript.py .
COPY unchained/chrome_bridge.py .
COPY unchained/cloud_tools.py .
COPY unchained/context_compact.py .
COPY unchained/tool_payloads.py .
COPY unchained/cdp.py .
COPY unchained/ddm.py .
COPY unchained/intel.py .
COPY unchained/nudge.py .
COPY unchained/reflex.py .
COPY unchained/CLAUDE.md .

RUN pip install --no-cache-dir \
    websockets>=16.0 \
    httpx>=0.28.1 \
    aiohttp>=3.11 \
    anthropic>=0.49 \
    fastmcp>=2.0 \
    PyJWT>=2.0 \
    cryptography>=42.0 \
    pypdf>=4.0

ENV PYTHONUNBUFFERED=1 \
    HOME=/home/unchained \
    UNCHAINED_DATA_DIR=/data \
    CDP_PORT=9222 \
    UNCHAINED_CHROME_HEADLESS=1 \
    UNCHAINED_CHROME_STEALTH=1 \
    NOPECHA_EXT_DIR=/opt/nopecha

LABEL nopecha.version=${NOPECHA_VERSION}

USER 10001:10001

CMD ["python", "chat_agent_openrouter.py", "--help"]
