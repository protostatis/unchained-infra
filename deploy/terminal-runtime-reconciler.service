[Unit]
Description=Unchained Public Terminal Runtime Reconciler
Documentation=https://github.com/protostatis/unchained-infra/blob/main/docs/public-live-terminal-pilot.md
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=ec2-user
Group=docker
EnvironmentFile=-/home/ec2-user/unchained/.env.reconciler
ExecStart=/usr/bin/python3 /home/ec2-user/unchained/deploy/terminal_runtime_reconciler.py
Restart=on-failure
RestartSec=30s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=120
SendSIGKILL=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/unchained
NoNewPrivileges=yes
MemoryHigh=256M
CPUQuota=50%
TasksMax=32

# Log to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-runtime-reconciler

[Install]
WantedBy=multi-user.target
