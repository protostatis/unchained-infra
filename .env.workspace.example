# Example environment for the financial workspace control plane (never commit
# real tokens/secrets). Copy into the host .env and enable the workspace
# profile:
#
#   docker compose -f docker-compose.yml -f docker-compose.public-terminal.yml \
#     --profile fin-terminal-workspace up -d fin-terminal-workspace-control
#
# The feature FAILS CLOSED: enabling FIN_TERMINAL_WORKSPACE_ENABLED=true
# without the explicit control token / S3 bucket / region / KMS key / cookie
# domain / validated runtime provider causes the control plane to refuse to
# start. It never falls back to JWT_SECRET or local storage, and /fin-terminal/
# is never falsely routed to the marketing index or the public singleton.

# Master enable (Caddy + control plane). Default false.
# Canonical value is "true"/"false" (Caddy expression matchers require the
# literal boolean); the control plane additionally normalizes 1|true|yes|on.
FIN_TERMINAL_WORKSPACE_ENABLED=false

# S2S control token for POST /internal/financial-workspace/* endpoints.
# Explicit only — JWT_SECRET is never a fallback. 32+ hex chars.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FIN_WORKSPACE_CONTROL_TOKEN=

# Parent domain for the HttpOnly claim cookie (callback subdomains read it).
FIN_WORKSPACE_COOKIE_DOMAIN=.unchainedsky.com

# Envelope-encrypted checkpoint storage (S3 + AWS KMS). All required.
FIN_WORKSPACE_S3_BUCKET=
FIN_WORKSPACE_S3_REGION=
FIN_WORKSPACE_KMS_KEY_ID=

# Host-side account-scoped runtime provider (hard enablement gate).
# Enabling the feature without a validated provider is a startup error: the
# provider must answer /v1/health with accountRuntime+checkpointFile
# capabilities (fin-workspace-runtime-provider.service). Defaults to the
# host gateway address the compose service resolves.
FIN_WORKSPACE_RUNTIME_PROVIDER_URL=http://host.docker.internal:8793
FIN_WORKSPACE_RUNTIME_PROVIDER_TOKEN=

# Control-plane base the provider uses for flush/wake callbacks (defaults to
# the Docker-internal service name). Override only for local E2E harness runs.
FIN_WORKSPACE_CONTROL_URL=http://fin-terminal-workspace-control:8790

# Shared proxy token for account runtimes. The control plane injects it toward
# each runtime (X-Fin-Terminal-Proxy-Token) and the provider passes it to the
# runtime container as MARKET_PROXY_TOKEN. Must match the provider's
# FIN_WORKSPACE_RUNTIME_PROXY_TOKEN. 32+ chars.
FIN_WORKSPACE_RUNTIME_PROXY_TOKEN=

# Public base for handoff/auth/callback URLs (Caddy workspace routes).
# The control plane serves /fin-terminal-workspace/* on this base; the claim
# surface lives under the dedicated /workspace/* namespace (never /auth/...).
FIN_TERMINAL_BASE_URL=https://unbrowser.unchainedsky.com/fin-terminal-workspace

# ── Host-side runtime provider env (fin-workspace-runtime-provider.service,
#    read from /home/ec2-user/unchained/.env.reconciler) ────────────────────
# The provider is the ONLY Docker-touching host component for account runtimes.
# These variables provision the immutable pinned app image
# (FIN_WORKSPACE_RUNTIME_APP_IMAGE, built with PUBLIC_BASE_PATH=/fin-terminal/
# and TERMINAL_RUNTIME_MODE=private-workspace), the allowlisted runtime env,
# and the shared MCP container.
FIN_WORKSPACE_RUNTIME_TOKEN=
FIN_WORKSPACE_RUNTIME_LISTEN=0.0.0.0:8793
FIN_WORKSPACE_RUNTIME_APP_IMAGE=unbrowser-fin-terminal:e937377b945ed84d721ebd06e22510b5f805e19d
FIN_WORKSPACE_RUNTIME_APP_PORT=8787
# Operator prerequisite: set true ONLY after verifying the pinned image. The
# capability additionally requires a passing image-contract probe (build mode
# live, base path /fin-terminal/, private-workspace mode, export path present).
FIN_WORKSPACE_RUNTIME_APP_CAPABLE=false
FIN_WORKSPACE_RUNTIME_CONTROL_CONTAINER=fin-terminal-workspace-control
FIN_WORKSPACE_RUNTIME_MCP_CONTAINER=fin-terminal-workspace-unbrowser-mcp
FIN_WORKSPACE_RUNTIME_CHECKPOINT_FILE=/data/checkpoint.json
FIN_WORKSPACE_RUNTIME_PROXY_TOKEN=
FIN_WORKSPACE_RUNTIME_ALLOWED_ORIGINS=https://unbrowser.unchainedsky.com
FIN_WORKSPACE_RUNTIME_MCP_URL=http://fin-terminal-workspace-unbrowser-mcp:8767/mcp
FIN_WORKSPACE_RUNTIME_MODEL_PROVIDER=openrouter
FIN_WORKSPACE_RUNTIME_MODEL_ID=
FIN_WORKSPACE_RUNTIME_OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
FIN_WORKSPACE_RUNTIME_OPENROUTER_API_KEY=
FIN_WORKSPACE_RUNTIME_MAX_OUTPUT_TOKENS=4096
FIN_WORKSPACE_LOCAL_RESEARCH_CONCURRENCY=1
FIN_WORKSPACE_RUNTIME_STATE_DIR=/var/lib/unchained/fin-workspace

# ── Gateway-side checkpoint wiring (aligned automatically) ──────────────────
# The gateway derives FINANCIAL_WORKSPACE_CHECKPOINTS from
# FIN_TERMINAL_WORKSPACE_ENABLED, FINANCIAL_WORKSPACE_CONTROL_TOKEN from
# FIN_WORKSPACE_CONTROL_TOKEN, and FINANCIAL_WORKSPACE_SERVICE_URL from the
# private control-plane service (http://fin-terminal-workspace-control:8790).
# No extra variables are required here; the S2S handoff-secret cookie is
# host-only (no Domain) because the gateway and control plane share the
# public terminal host.

# Claim-aware OAuth across providers (reuses the existing provider config).
# GOOGLE_CLIENT_ID / FACEBOOK_APP_ID / FACEBOOK_APP_SECRET /
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET come from the main .env.
