# Example environment for the financial workspace control plane (never commit
# real tokens/secrets). Copy into the host .env and enable the workspace
# profile:
#
#   docker compose -f docker-compose.yml -f docker-compose.public-terminal.yml \
#     --profile fin-terminal-workspace up -d fin-terminal-workspace-control
#
# The feature FAILS CLOSED: enabling FIN_TERMINAL_WORKSPACE_ENABLED=true
# without the explicit control token / S3 bucket / region / KMS key / cookie
# domain causes the control plane to refuse to start. It never falls back to
# JWT_SECRET or local storage.

# Master enable (Caddy + control plane). Default false.
FIN_TERMINAL_WORKSPACE_ENABLED=false

# S2S control token for POST /internal/financial-workspace/* endpoints.
# Explicit only — JWT_SECRET is never a fallback. 32+ hex chars.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
FIN_WORKSPACE_CONTROL_TOKEN=

# Parent domain for the HttpOnly claim cookie (callback subdomains read it).
FIN_WORKSPACE_COOKIE_DOMAIN=.unchainedsky.com

# Envelope-encrypted checkpoint storage (S3 + AWS KMS). All required.
FIN_WORKSPACE_S3_BUCKET=
FIN_WORKSPACE_S3_REGION=
FIN_WORKSPACE_KMS_KEY_ID=

# Public base for handoff/auth/callback URLs (Caddy workspace routes).
# The control plane serves /fin-terminal-workspace/* on this base.
FIN_TERMINAL_BASE_URL=https://unbrowser.unchainedsky.com/fin-terminal-workspace

# Claim-aware OAuth across providers (reuses the existing provider config).
# GOOGLE_CLIENT_ID / FACEBOOK_APP_ID / FACEBOOK_APP_SECRET /
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET come from the main .env.
